{
  "name": "@cutmyvideo/sdk",
  "version": "1.5.0",
  "description": "Typed local and HTTP clients for cutmyvideo-core",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./local": { "types": "./dist/local.d.ts", "import": "./dist/local.js" },
    "./collections": { "types": "./dist/collections.d.ts", "import": "./dist/collections.js" },
    "./sources": { "types": "./dist/sources.d.ts", "import": "./dist/sources.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=120000 test/client.test.mjs test/local.test.mjs test/collections.test.mjs test/sources.test.mjs test/subtitles.test.mjs test/project-contracts.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "22.20.5", "typescript": "7.0.2" },
  "repository": { "type": "git", "url": "https://github.com/Kay0k1/cutmyvideo-core.git", "directory": "sdk/typescript" }
}
